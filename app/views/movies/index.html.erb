<div class="header">
  <h1>Movies</h1>
</div>

<%= link_to 'Add New Movie', new_movie_path, class: 'btn btn-primary' %>

<table id="movies">
  <thead>
    <tr>
      <th id="title_header" class="<%= 'sorted' if @sort_column == 'title' %>">
        <%= link_to 'Movie Title', movies_path(sort: 'title'), id: :title_header %>
      </th>
      <th>Rating</th>
      <th id="release_date_header" class="<%= 'sorted' if @sort_column == 'release_date' %>">
        <%= link_to 'Release Date', movies_path(sort: 'release_date'), id: :release_date_header %>
      </th>
      <th>Actions</th>
    </tr>
  </thead>
  <tbody>
    <% @movies.each do |movie| %>
      <tr>
        <td><strong><%= movie.title %></strong></td>
        <td><span class="rating"><%= movie.rating %></span></td>
        <td><%= movie.release_date.strftime("%B %d, %Y") %></td>
        <td>
          <%= link_to 'Show', movie_path(movie), class: 'btn btn-secondary' %>
          <%= link_to 'Edit', edit_movie_path(movie), class: 'btn btn-success' %>
          <%= link_to 'Delete', movie_path(movie), 
                      data: { turbo_method: :delete, turbo_confirm: 'Are you sure you want to delete this movie?' }, 
                      class: 'btn btn-danger' %>
        </td>
      </tr>
    <% end %>
  </tbody>
</table>

<% if @sort_column %>
  <div class="sort-info">
    <p>Sorted by: <strong><%= @sort_column.titleize %></strong></p>
  </div>
<% end %>