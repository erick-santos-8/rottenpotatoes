<!DOCTYPE html>
<html>
  <head>
    <title>RottenPotatoes!</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <% if flash[:notice] %>
      <div id="notice" class="message"><%= flash[:notice] %></div>
    <% elsif flash[:warning] %>
      <div id="warning" class="message"><%= flash[:warning] %></div>
    <% end %>

    <div id="main">
      <%= yield %>
    </div>
  </body>
</html>